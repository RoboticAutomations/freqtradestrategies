{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "timeframe": "1h",
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": false,
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "bybit",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT"
        ],
        "pair_blacklist": [
            "BNB/.*"
        ]
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "telegram": {
        "enabled": true,
        "token": "",
        "chat_id": "",
        "keyboard": [
            [
                "/start",
                "/pause",
                "/stop"
            ],
            [
                "/status",
                "/status table",
                "/balance"
            ],
            [
                "/profit",
                "/daily"
            ],
            [
                "/forcelong",
                "/forceshort",
                "/forceexit"
            ],
            [
                "/reload_config",
                "/help"
            ]
        ]
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "REDACTED-BY-REPO-HYGIENE",
        "ws_token": "REDACTED-BY-REPO-HYGIENE",
        "CORS_origins": [],
        "username": "REDACTED-BY-REPO-HYGIENE",
        "password": "REDACTED-BY-REPO-HYGIENE"
    },
    "freqai": {
        "enabled": false,
        "feature_parameters": {
            "include_timeframes": [],
            "include_corr_pairlist": [],
            "label_period_candles": 10,
            "include_shifted_candles": 0,
            "indicator_periods_candles": [
                8
            ]
        },
        "data_split_parameters": {
            "test_size": 0,
            "random_state": 1,
            "shuffle": false
        },
        "model_training_parameters": {}
    },
    "bot_name": "GPTTrader",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {
        "process_throttle_secs": 5
    }
}
